# Postgres connection using the restricted chatbot_readonly role, via Supabase's
# Transaction Pooler (IPv4-compatible — see reactive-google-ai-agent's README for why).
# Format: postgresql://<role>.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql://chatbot_readonly.PROJECT_REF:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Phase 4 — semantic cache. Embedding model used to turn questions into
# vectors stored in the `semantic_cache` table (pgvector), and the cosine
# similarity (0-1) above which a cached answer is reused instead of
# re-running the full Gemini + SQL pipeline.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SEMANTIC_CACHE_THRESHOLD=0.92

# Phase 5 — auto few-shot learning. How many similar past (question, sql)
# examples to pull from `sql_examples` into the SQL-generation prompt, and
# the minimum cosine similarity (0-1) for an example to be worth including.
FEWSHOT_TOP_K=3
FEWSHOT_MIN_SIMILARITY=0.5

# Phase 6 — RAG fallback. How many similar knowledge_base chunks to retrieve
# for a store-policy/general question, and the minimum cosine similarity
# (0-1) for a chunk to be worth grounding an answer in.
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.5

# Phase 7 — session memory. Redis connection for the server-side rolling
# conversation window (replaces trusting whatever history the client
# resends). Use Upstash's "rediss://" (TLS) connection string, not the plain
# "redis://" one, when connecting from outside Upstash's own network.
REDIS_URL=rediss://default:PASSWORD@your-instance.upstash.io:6379

# How many messages (not exchanges) the rolling window keeps per session,
# and how many seconds of inactivity before a session's history expires and
# the next message starts a fresh conversation under the same cookie.
SESSION_HISTORY_MAX_MESSAGES=12
SESSION_TTL_SECONDS=1800

# How many recent messages get folded into the text embedded for the
# semantic cache (cache.js) and RAG retrieval (rag.js), so a context-
# dependent follow-up ("what about a cheaper one?") is disambiguated by
# what it's actually following rather than embedded as a bare, ambiguous
# phrase on its own.
VECTOR_CONTEXT_MESSAGES=4
